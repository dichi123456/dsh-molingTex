{
  "name": "dsh-plugin-moling-latex",
  "version": "0.8.5",
  "private": true,
  "description": "moling_latex —— 墨灵TeX 的 DSH 插件：右侧栏 LaTeX 工作台（目录树 / 编辑 / 自动补全 / 编译 / 日志 / PDF / 21 个内置模板）+ 5 个 Agent 工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "smoke": "node test/smoke.mjs",
    "smoke:server": "node test/server-smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "dichi123456 <dichi123456@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dichi123456/dsh-molingTex.git"
  },
  "homepage": "https://github.com/dichi123456/dsh-molingTex#readme",
  "bugs": {
    "url": "https://github.com/dichi123456/dsh-molingTex/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "latex",
    "tex",
    "synctex",
    "codeMirror"
  ],
  "publishConfig": {
    "access": "public"
  }
}
