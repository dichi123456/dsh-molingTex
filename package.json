{
  "name": "dsh-plugin-moling-latex",
  "version": "0.5.0",
  "private": true,
  "description": "moling_latex —— 墨灵TeX 的 DSH 插件：右侧栏 LaTeX 工作台（目录树 / 编辑 / 编译 / 日志 / PDF）+ 5 个 Agent 工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "smoke": "node test/smoke.mjs",
    "smoke:server": "node test/server-smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
